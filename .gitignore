.oh/skills.lock.lck
**/.env*
# oh.json holds every non-secret setting and is tracked; the root dotenv holds
# secrets only. The example is a tracked template, so it survives **/.env*.
!/.env.example
!/.oh/templates/.env.example
# harness.yaml was removed in 0.4.0. These stay ONE more release so a stale
# local artifact from a pre-0.4.0 checkout is never accidentally committed;
# .oh/scripts/migrate-harness-yaml.sh renames the file to .migrated.
/harness.yaml
/harness.yml
/harness.yaml.migrated
# Derived env artifact the deleted Makefile target generated (not matched by **/.env*)
.devcontainer/.harness.yaml.env
/.oh/config.json
.worktrees/*
!.worktrees/AGENTS.md
!.worktrees/CLAUDE.md
projects/*
!projects/AGENTS.md
!projects/CLAUDE.md
.claude/worktrees/
# Task artifacts are local runtime state; keep only the directory guide tracked.
.oh/tasks/*
!.oh/tasks/README.md

# Build artifacts
**/.venv/
**/node_modules/
**/dist/
*.tsbuildinfo

# IDE
.vscode/
.idea/

# Screenshots (keep dir, ignore contents)
**/.claude/screenshots/*
!**/.claude/screenshots/.gitkeep

# Croner runtime artifacts (keep crons/*.md tracked)
crons/.pid
crons/*.log

**/.next
**/.ralph/archives/
**/src/generated/

**/.pnpm-store
**/.claude/plans
**/.claude/specs/*
**/.claude/settings.local.json
**/auth.json
**/.credentials.json

# Hermes project-local runtime state (keep README tracked)
/.hermes/*
!/.hermes/README.md
!/.hermes/hooks/
!/.hermes/config.yaml
!/.hermes/config.yml

# prime-agent project-local runtime state. Credentials already fall under the
# **/auth.json rule above; these are the session and telemetry files the agent
# writes beside its tracked config.
.prime/agent/sessions/
.prime/agent/telemetry.json

**/scheduled_tasks.lock
# Legacy/future workspace package build artifacts
packages/*/build/
packages/*/node_modules/
# Wiki corpus owned by the /wiki skill — entries are local scratch by default;
# the operator whitelists curated entries into git with `git add -f`. Raw
# snapshots are immutable provenance, fully ignored except the directory anchor.
.oh/skills/wiki/corpus/*
!.oh/skills/wiki/corpus/README.md
!.oh/skills/wiki/corpus/raw/
.oh/skills/wiki/corpus/raw/*
!.oh/skills/wiki/corpus/raw/README.md

# Per-session agent memory and cron runtime state — local scratch, like the
# wiki corpus above. Nothing here is tracked on any branch; the operator
# whitelists an entry with `git add -f` if one is ever worth keeping.
.oh/memory/
.oh/crons/
